{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Information",
        "Grpc.Net.Client.Internal": "Warning",
        "System.Net.Http": "Warning",
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Mvc.Infrastructure": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning",
        "Power.CrossCutting": "Warning",
        "Power.Domain": "Warning",
        "Power.Context.Kernel": "Warning",
        "Power.Gateway.API": "Warning",
        "Power.Gateway.Kernel": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Files": {
    "ContainerName": "xxxxx-binary",
    "ImagesRawFolder": "xxxxx/raw",
    "ImagesThumbnailFolder": "xxxxx/thumbnails",
    "BinariesFolder": "xxxxx/binaries"
  }
}
